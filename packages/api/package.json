{
  "name": "@genaiscript/api",
  "version": "1.0.0",
  "main": "./dist/commonjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "type": "module",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@genaiscript/core": "workspace:*",
    "debug": "^4.4.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/node": "^22.0.0",
    "@vitest/coverage-istanbul": "^3.2.3",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "tshy": "^3.0.2",
    "typescript": "~5.8.3",
    "vitest": "^3.2.3"
  },
  "scripts": {
    "build": "npm run clean && tshy",
    "clean": "rimraf dist",
    "format:check": "prettier --check src/**/*.ts src/**/*.cts src/**/*.mjs src/**/*.json",
    "format:fix": "prettier src/**/*.ts src/**/*.cts src/**/*.mjs src/**/*.json --write",
    "test": "vitest"
  },
  "keywords": [],
  "author": "Microsoft Corporation",
  "license": "MIT",
  "description": "The runtime for GenAIScript, providing the core functionality and APIs for executing scripts.",
  "repository": "github:microsoft/genaiscript",
  "bugs": {
    "url": "https://github.com/microsoft/genaiscript/issues"
  },
  "tshy": {
    "dialects": [
      "esm",
      "commonjs"
    ],
    "project": "./tsconfig.src.json",
    "exports": {
      ".": "./src/index.ts",
      "./package.json": "./package.json"
    },
    "selfLink": false
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  }
}
