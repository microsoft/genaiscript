{
  "name": "@genaiscript/runtime",
  "version": "1.0.0",
  "main": "./dist/commonjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "type": "module",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@genaiscript/core": "workspace:*",
    "@inquirer/prompts": "^7.5.3",
    "dockerode": "^4.0.7",
    "es-toolkit": "^1.39.3",
    "glob": "^11.0.3",
    "memorystream": "^0.3.1",
    "playwright": "^1.53.0",
    "tslib": "catalog:",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/debug": "^4.1.12",
    "@types/dockerode": "^3.3.41",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "tshy": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "npm run clean && tshy",
    "clean": "rimraf dist",
    "format:check": "prettier --config ../../.prettierrc.json --ignore ../../.prettierignore --check src/**/*.ts src/**/*.cts src/**/*.mjs src/**/*.json",
    "format:fix": "prettier --config ../../.prettierrc.json  --ignore ../../.prettierignore  --write src/**/*.ts src/**/*.cts src/**/*.mjs src/**/*.json",
    "lint:check": "eslint src",
    "lint:fix": "eslint src --fix --fix-type [problem,suggestion]",
    "test": "vitest"
  },
  "keywords": [],
  "author": "Microsoft Corporation",
  "license": "MIT",
  "description": "The runtime for GenAIScript, providing the core functionality and APIs for executing scripts.",
  "repository": "github:microsoft/genaiscript",
  "bugs": {
    "url": "https://github.com/microsoft/genaiscript/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "tshy": {
    "dialects": [
      "esm",
      "commonjs"
    ],
    "project": "./tsconfig.src.json",
    "exports": {
      ".": "./src/index.ts",
      "./package.json": "./package.json"
    },
    "selfLink": false
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  }
}
