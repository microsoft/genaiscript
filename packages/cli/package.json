{
  "name": "genaiscript",
  "version": "1.142.0",
  "type": "module",
  "bin": "./dist/src/index.js",
  "files": [
    "dist/",
    "README.md"
  ],
  "publisher": "Microsoft",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microsoft/genaiscript.git"
  },
  "homepage": "https://microsoft.github.io/genaiscript",
  "keywords": [
    "genai",
    "ai",
    "agentic",
    "agent",
    "cli",
    "prompt",
    "llm",
    "generative ai",
    "gpt4",
    "chatgpt",
    "ollama",
    "llamacpp",
    "chatgpt"
  ],
  "description": "A CLI for GenAIScript, a generative AI scripting framework.",
  "license": "MIT",
  "overrides": {
    "@mapbox/node-pre-gyp": "^2.0.0",
    "glob": "^11.0.2",
    "mermaid": "^11.6.0"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@fastify/cors": "^11.0.1",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.2",
    "@genaiscript/api": "workspace:*",
    "@genaiscript/core": "workspace:*",
    "@genaiscript/runtime": "workspace:*",
    "@inquirer/prompts": "^7.5.3",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "chokidar": "^4.0.3",
    "commander": "^12.1.0",
    "cross-fetch": "^4.1.0",
    "debug": "^4.4.1",
    "diff": "^7.0.0",
    "dotenv": "^16.5.0",
    "es-toolkit": "^1.38.0",
    "execa": "^9.6.0",
    "fastify": "^5.3.3",
    "file-type": "^20.5.0",
    "fs-extra": "^11.3.0",
    "openai": "^4.103.0",
    "replace-ext": "^2.0.0",
    "ws": "^8.18.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/diff": "^6.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.15.2",
    "@types/papaparse": "^5.3.15",
    "@types/prompts": "^2.4.9",
    "@types/replace-ext": "^2.0.2",
    "@types/ws": "^8.5.14",
    "@vitest/coverage-istanbul": "^3.2.4",
    "es-toolkit": "^1.38.0",
    "execa": "^9.6.0",
    "glob": "^11.0.2",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "npm run clean && tsc -p . && node ./scripts/fixup.mjs",
    "clean": "rimraf dist",
    "format:check": "prettier --check src/**/*.ts src/**/*.cts src/**/*.mjs src/**/*.json",
    "format:fix": "prettier src/**/*.ts src/**/*.cts src/**/*.mjs src/**/*.json --write",
    "test": "vitest"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "module": "./dist/src/index.js"
}
